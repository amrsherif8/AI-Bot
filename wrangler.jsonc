{
  "name": "funke",
  "main": "src/index.js",
  "compatibility_date": "2026-10-31",
  "containers": [
    {
      "class_name": "FunkeContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "FUNKE", "class_name": "FunkeContainer" }]
  },
  "exports": {
    "FunkeContainer": { "type": "durable-object", "storage": "sqlite" }
  }
}
